# Production environment template for VerifyMeasure.
# Copy to .env.production, fill in real values, and source it from the service
# manager (or paste into your PaaS dashboard). Never commit the filled file.
#
# In production backend/app/core/config.py ignores backend/.env entirely, so
# every value below MUST be present in the real process environment.

# Required. Selects the production code path and enables fail-fast validation.
ENVIRONMENT=production

# Required. Neon's direct (non-pooled) PostgreSQL connection string, copied
# verbatim from Neon Console > Connection Details. Must be postgresql:// or
# postgres:// and must not contain @localhost / @127.0.0.1. Keep the
# ?sslmode=require parameter that Neon appends.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_min_32_characters_long_random_secret

# Required. Deployed frontend origin, https only. This is the value used in
# CORS and as the base for QR / public verification URLs.
FRONTEND_URL=https://verifymeasure.example

# Optional. Public API base URL, used for links generated by the backend.
BACKEND_URL=https://api.verifymeasure.example

# Optional. Override if the public verification page is served from a
# different host than FRONTEND_URL. Defaults to FRONTEND_URL.
PUBLIC_VERIFICATION_URL=https://verifymeasure.example

# Required. Comma-separated exact origins allowed to call the API. The frontend
# origin must be present. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=https://verifymeasure.example

# Optional. Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. One-time token for administrator bootstrap.
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME

# Must be false in production. Startup aborts if either is true.
DEBUG=false
RELOAD=false
