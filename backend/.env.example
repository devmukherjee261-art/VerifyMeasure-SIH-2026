# Local development environment. Copy to .env and adjust.
# In production this file is ignored entirely and every value must be present
# in the real process environment. See .env.production.example and DEPLOY.md.

# "development" or "production". Production enables strict fail-fast validation.
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/sih_2026
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih_2026
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://127.0.0.1:8000
PUBLIC_VERIFICATION_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret
DEBUG=true
RELOAD=true
